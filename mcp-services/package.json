  "description": "Novalyte MCP Services - Cloud Run deployment for dealflow, market-intel, and workforce endpoints",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "novalyte",
